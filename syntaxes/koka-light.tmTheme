      }
    },
    {
      "scope": "source.nix entity.other.attribute-name",
      "settings": {
        "foreground": "#6F42C1"
      }
    },
    {
      "scope": "source.nix meta.embedded variable.parameter",
      "settings": {
        "foreground": "#005CC5"
      }
    },
    {
      "scope": "source.nix meta.embedded entity.other.attribute-name",
      "settings": {
        "foreground": "#005CC5"
      }
    },
    {
      "scope": "source.nix variable.parameter.name",
      "settings": {
