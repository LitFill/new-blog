      "scope": "source.json constant.numeric",
      "settings": {
        "foreground": "#005CC5"
      }
    },
    {
      "scope": "source.json keyword",
      "settings": {
        "foreground": "#005CC5"
      }
    },
    {
      "scope": "source.json punctuation.definition",
      "settings": {
        "foreground": "#005CC5"
      }
    },
    {
      "scope": "source.json entity.name",
      "settings": {
        "foreground": "#005CC5"
      }
    },
    {
      "scope": "source.json support.type",
      "settings": {
