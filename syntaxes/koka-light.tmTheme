{
  "colors": {
    "foreground": "#24292E",
    "background": "#FFFFFF"
  },
  "displayName": "koka-light",
  "name": "koka-light",
  "tokenColors": [
    {
      "scope": "source.koka comment",
      "settings": {
        "foreground": "#008000"
      }
    },
    {
      "scope": "source.koka keyword",
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "scope": "source.koka keyword.operator.arrow",
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "scope": "source.koka storage.type",
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "scope": "source.koka storage.modifier",
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "scope": "source.koka string",
      "settings": {
        "foreground": "#800000"
      }
    },
    {
      "scope": "source.koka constant.character",
      "settings": {
        "foreground": "#800000"
      }
    },
    {
      "scope": "source.koka constant.numeric",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "source.koka entity.name.type",
      "settings": {
        "foreground": "#008080"
      }
    },
    {
      "scope": "source.koka entity.name.type.tpp",
      "settings": {
        "foreground": "#555555"
      }
    },
    {
      "scope": "source.koka entity.name.type.constructor",
      "settings": {
        "foreground": "#800080"
      }
    },
    {
      "scope": "source.koka support.module",
      "settings": {
        "foreground": "#000080"
      }
    },
    {
      "scope": "source.nix comment.line",
      "settings": {
        "foreground": "#6A737D"
      }
    },
    {
      "scope": "source.nix string.quoted",
      "settings": {
        "foreground": "#032F62"
      }
    },
    {
      "scope": "source.nix punctuation.definition.string",
      "settings": {
        "foreground": "#032F62"
      }
    },
    {
      "scope": "source.nix punctuation.section.embedded",
      "settings": {
        "foreground": "#032F62"
      }
    },
    {
